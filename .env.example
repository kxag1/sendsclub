# APP_URL: The URL where this applet is hosted (e.g. https://sendsclub.vip).
APP_URL="https://sendsclub.vip"

# ADMIN_EMAIL / ADMIN_USERNAME / ADMIN_PASSWORD:
# Optional server-side administrator credentials for SendsClub.
# When set, the server automatically provisions or validates the admin account.
# If left unset, use the in-app First-Run Admin Claim screen on initial launch.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# SESSION_SECRET:
# Random 32+ character string used to sign session tokens in production (e.g. Replit Secrets).
SESSION_SECRET=

# ALLOWED_ORIGINS / VITE_API_BASE_URL:
# Only needed if hosting the static frontend separately (e.g. Cloudflare Pages at https://the.sendsclub.vip)
# from the Express backend server. Leave empty when served together from server.ts.
ALLOWED_ORIGINS=
VITE_API_BASE_URL=
